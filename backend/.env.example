MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGODB_DATABASE=JogaJunto
PORT=3333

# Uma ou mais origens autorizadas no CORS, separadas por vírgula.
# Ex.: https://jogajunto-player.vercel.app,https://jogajunto-admin.vercel.app,https://jogajunto.vercel.app
# Sem essa variável, o backend libera qualquer origem (modo aberto).
FRONTEND_URL=

JWT_SECRET=troque-por-um-valor-aleatorio-longo
ADMIN_CREATION_SECRET=troque-por-um-valor-aleatorio-longo
ADMIN_JWT_SECRET=troque-por-um-valor-aleatorio-longo
